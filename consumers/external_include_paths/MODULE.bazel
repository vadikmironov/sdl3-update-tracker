# A consumer that builds with external_include_paths, which moves the search
# paths of every other repository to -isystem, those of the module included.
# It takes the newest rules_cc. From 0.2.20, the feature moves the root of each
# repository from -iquote to -isystem too.
module(
    name = "sdl3_consumer_external_include_paths",
    version = "0.0.0",
)

bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "sdl3", version = "%{module_version}")
