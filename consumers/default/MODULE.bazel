# The consumer that CI builds and tests @sdl3//... from, through the rendered
# registry.
module(
    name = "sdl3_consumer",
    version = "0.0.0",
)

# Before rules_cc, so that its C++ toolchain is the one used on macOS.
bazel_dep(name = "apple_support", version = "2.3.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "sdl3", version = "%{module_version}")
